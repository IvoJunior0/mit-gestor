# O banco "manutencao_industrial_test" é criado automaticamente pelo
# docker-compose (ver docker/init-scripts/01-criar-banco-teste.sql).
# Se o container do Postgres já existia antes dessa alteração, recrie o
# volume uma vez com:
#   docker compose down -v && docker compose up -d
# ou crie o banco manualmente:
#   docker exec -it manutencao-industrial-postgres psql -U postgres -c "CREATE DATABASE manutencao_industrial_test;"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manutencao_industrial_test?schema=public"
JWT_SECRET="segredo-de-teste-integracao"
PORT=3001
