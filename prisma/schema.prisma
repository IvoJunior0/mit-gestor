generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ADMINISTRADOR
  GESTOR
  TECNICO
  OPERADOR
}

enum StatusMaquina {
  EM_OPERACAO
  EM_MANUTENCAO
  PARADA
  INATIVA
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

enum StatusOrdemServico {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  CONCLUIDA
  CANCELADA
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model Usuario {
  id                  String        @id @default(uuid())
  nome                String
  email               String        @unique
  senha               String
  tipo                TipoUsuario
  criadoEm            DateTime      @default(now())
  ordensServico       OrdemServico[] @relation("TecnicoResponsavel")
}

model Setor {
  id                  String        @id @default(uuid())
  nome                String        @unique
  descricao           String?
  criadoEm            DateTime      @default(now())
  maquinas            Maquina[]
}

model Maquina {
  id                  String         @id @default(uuid())
  codigo              String         @unique
  nome                String
  fabricante           String?
  modelo              String?
  numeroSerie         String?        @unique
  horimetro           Int            @default(0)
  status              StatusMaquina  @default(EM_OPERACAO)
  setorId             String
  criadoEm            DateTime       @default(now())
  atualizadoEm        DateTime       @updatedAt
  setor               Setor          @relation(fields: [setorId], references: [id])
  ordensServico       OrdemServico[]
  manutencoes         Manutencao[]
}

model Peca {
  id                  String             @id @default(uuid())
  codigo              String             @unique
  nome                String
  quantidadeEstoque   Int                @default(0)
  estoqueMinimo       Int                @default(0)
  unidadeMedida       String
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt
  itensOrdemServico   ItemOrdemServico[]
}

model OrdemServico {
  id                    String              @id @default(uuid())
  descricao             String
  prioridade             Prioridade
  status                 StatusOrdemServico @default(ABERTA)
  maquinaId              String
  tecnicoResponsavelId  String?
  criadoEm               DateTime            @default(now())
  iniciadoEm             DateTime?
  concluidoEm            DateTime?
  maquina                Maquina             @relation(fields: [maquinaId], references: [id])
  tecnicoResponsavel     Usuario?            @relation("TecnicoResponsavel", fields: [tecnicoResponsavelId], references: [id])
  itens                  ItemOrdemServico[]
  manutencao             Manutencao?
}

model Manutencao {
  id                String          @id @default(uuid())
  tipo              TipoManutencao
  descricao         String
  maquinaId         String
  ordemServicoId    String?         @unique
  realizadaEm       DateTime        @default(now())
  proximaManutencao DateTime?
  maquina           Maquina         @relation(fields: [maquinaId], references: [id])
  ordemServico      OrdemServico?   @relation(fields: [ordemServicoId], references: [id])
}

model ItemOrdemServico {
  id              String        @id @default(uuid())
  quantidade      Int
  ordemServicoId  String
  pecaId          String
  ordemServico    OrdemServico @relation(fields: [ordemServicoId], references: [id])
  peca            Peca          @relation(fields: [pecaId], references: [id])

  @@unique([ordemServicoId, pecaId])
}